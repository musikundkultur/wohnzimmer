{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'customManagers:dockerfileVersions',
    'docker:enableMajor',
    ':automergeDigest',
    ':automergePatch',
    ':automergeStableNonMajor',
    ':dependencyDashboard',
    ':disableRateLimiting',
    ':semanticCommits',
    'github>martinohmann/.github//renovate/default.json5',
    'github>musikundkultur/wohnzimmer//.github/renovate/groups.json5',
    'github>musikundkultur/wohnzimmer//.github/renovate/labels.json5',
    'github>musikundkultur/wohnzimmer//.github/renovate/semanticCommits.json5',
  ],
  dependencyDashboard: {
    enabled: true,
    title: 'Renovate Dashboard 🤖',
  },
  schedule: [
    'on the first day of the month',
  ],
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  assigneesFromCodeOwners: false,
  reviewersFromCodeOwners: true,
}
